alias aptup="sudo apt update"
alias aptin="sudo apt install"
alias aptrm="sudo apt remove"
alias brewin="brew install"
alias brewls="brew list"
alias srcsh="exec zsh"
alias fetch="git fetch"
# alts
alias ls="eza"
alias lls="eza -l"
alias la="eza -la"
# scripts
alias mk="bash ~/.config/bash/scripts/mk.sh"
alias mkall="bash ~/.config/bash/scripts/mkall.sh"
alias v="bash ~/.config/bash/scripts/v.sh"