[core]
        editor = vim
        pager = moor
        excludesfile = ~/.config/git/.gitignore_global
[diff]
        external = delta

[IncludeIf "gitdir:~/dev/**"]
	path = ~/.config/git/dev.gitconfig

[IncludeIf "gitdir:~/vol/**"]
	path = ~/.config/git/vol.gitconfig

[IncludeIf "gitdir:~/ath/**"]
	path = ~/.config/git/ath.gitconfig